#!/bin/sh /etc/rc.common
# Jiyun A10 front-panel activity LED daemon (left = wlan0/wlan1 traffic,
# right = M.2 slot traffic).  START=99 so it runs after S96led has applied
# the UCI LED configuration; the daemon then takes over the two activity
# LEDs and leaves the middle "sys" LED alone.
START=99
USE_PROCD=1

start_service() {
	procd_open_instance
	procd_set_param command /usr/sbin/jiyun-ledd
	procd_set_param respawn 3600 5 0
	procd_close_instance
}

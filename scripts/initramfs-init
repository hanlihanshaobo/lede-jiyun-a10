#!/bin/busybox sh
#
# First-boot offline rootfs resize for the Jiyun A10.
#
# Two target-specific facts drive this script:
#
#   * The kernel is built WITHOUT devtmpfs (the generic kernel config sets
#     CONFIG_DEVTMPFS=n and the rockchip config does not override it), so
#     /dev in the initramfs only has the console/null nodes from the cpio.
#   * /init runs before the eMMC probe has finished, and the kernel does not
#     run prepare_namespace()/wait_for_device_probe() for an initramfs init.
#
# Therefore we create the mmc device nodes ourselves and wait for the
# partition to show up in sysfs before mounting it.  Then e2fsck/resize2fs
# run on the unmounted p1 (the kernel 6.18 online resize path cannot grow a
# make_ext4fs image past ~377 MB), before switch_root into the real rootfs.
# /etc/.expanded makes later boots skip the offline work.

BB=/bin/busybox
ROOT=/dev/mmcblk0p1
WHOLE=/dev/mmcblk0
LOG=/tmp/initramfs.log
CONS=/dev/console

: > "$LOG" 2>/dev/null
log() { echo "$*" >> "$LOG" 2>/dev/null; echo "jiyun-initramfs: $*" > "$CONS" 2>/dev/null; }
msg() { echo "jiyun-initramfs: $*" > "$CONS" 2>/dev/null; }

$BB mount -t proc proc /proc 2>/dev/null
$BB mount -t sysfs sys /sys 2>/dev/null
$BB mount -t devtmpfs dev /dev 2>/dev/null || true

# devtmpfs is not available: create the eMMC nodes explicitly.
[ -b "$WHOLE" ] || $BB mknod "$WHOLE" b 179 0 2>/dev/null
[ -b "$ROOT" ] || $BB mknod "$ROOT" b 179 1 2>/dev/null

# Wait for the eMMC probe to register the partition (sysfs is authoritative;
# a node created by mknod is "block" even before the device exists).
i=0
while [ ! -e /sys/class/block/mmcblk0p1 ] && [ "$i" -lt 60 ]; do
	$BB sleep 1
	i=$((i + 1))
done
msg "waited ${i}s for mmcblk0p1"
log "waited ${i}s"

# Best-effort debug log in the reserved gap before p1 (LBA 1000).
$BB dd if="$LOG" of="$WHOLE" bs=512 seek=1000 conv=fsync 2>/dev/null

# Already expanded?  Mount read-only first to avoid a journal replay before
# the flag check.
if $BB mount -o ro "$ROOT" /mnt 2>/dev/null; then
	if [ -f /mnt/etc/.expanded ]; then
		msg "rootfs already expanded, checking filesystem"
		j=0
		while ! $BB umount /mnt 2>/dev/null; do
			j=$((j + 1))
			[ "$j" -ge 10 ] && break
			$BB sleep 1
		done
		# Only run e2fsck if /mnt really is unmounted.
		if ! $BB grep -q " $ROOT /mnt " /proc/mounts 2>/dev/null; then
			if [ -x /sbin/e2fsck ]; then
				msg "e2fsck -p $ROOT"
				/sbin/e2fsck -p "$ROOT" >>"$LOG" 2>&1
				log "e2fsck -p rc=$?"
			fi
		fi
		if $BB mount -o rw "$ROOT" /mnt 2>/dev/null; then
			$BB sync
			$BB mkdir -p /mnt/proc /mnt/sys /mnt/dev 2>/dev/null
			$BB mount -t proc proc /mnt/proc 2>/dev/null
			$BB mount -t sysfs sys /mnt/sys 2>/dev/null
			$BB mount -t devtmpfs dev /mnt/dev 2>/dev/null
			[ -e /mnt/dev/console ] || $BB mknod /mnt/dev/console c 5 1 2>/dev/null
			[ -e /mnt/dev/null ] || $BB mknod /mnt/dev/null c 1 3 2>/dev/null
			exec $BB switch_root /mnt /sbin/init
		fi
	fi
	j=0
	while ! $BB umount /mnt 2>/dev/null; do
		j=$((j + 1))
		[ "$j" -ge 10 ] && break
		$BB sleep 1
	done
else
	msg "rootfs not mountable read-only, running fsck"
fi

if [ -x /sbin/e2fsck ]; then
	msg "e2fsck -fy $ROOT"
	/sbin/e2fsck -fy "$ROOT" >>"$LOG" 2>&1
	log "e2fsck rc=$?"
else
	msg "e2fsck missing"
fi

resized=0
if [ -x /sbin/resize2fs ]; then
	msg "resize2fs $ROOT"
	if /sbin/resize2fs "$ROOT" >>"$LOG" 2>&1; then
		resized=1
	fi
	log "resize2fs done rc=$?"
else
	msg "resize2fs missing"
fi

j=0
while ! $BB mount -o rw "$ROOT" /mnt 2>/dev/null; do
	j=$((j + 1))
	[ "$j" -ge 10 ] && break
	$BB sleep 1
done

if [ -d /mnt/etc ]; then
	[ "$resized" = 1 ] && $BB touch /mnt/etc/.expanded
	$BB sync
	$BB dd if="$LOG" of="$WHOLE" bs=512 seek=1000 conv=fsync 2>/dev/null
	msg "handing over to rootfs"
	$BB mkdir -p /mnt/proc /mnt/sys /mnt/dev 2>/dev/null
	$BB mount -t proc proc /mnt/proc 2>/dev/null
	$BB mount -t sysfs sys /mnt/sys 2>/dev/null
	$BB mount -t devtmpfs dev /mnt/dev 2>/dev/null
	[ -e /mnt/dev/console ] || $BB mknod /mnt/dev/console c 5 1 2>/dev/null
	[ -e /mnt/dev/null ] || $BB mknod /mnt/dev/null c 1 3 2>/dev/null
	$BB sync
	exec $BB switch_root /mnt /sbin/init
fi

msg "cannot mount $ROOT, dropping to shell"
$BB dd if="$LOG" of="$WHOLE" bs=512 seek=1000 conv=fsync 2>/dev/null
exec $BB sh

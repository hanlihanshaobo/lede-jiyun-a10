# Seed .config - only real OpenWrt symbols belong here. Kernel symbols
# (CONFIG_RTL8367B_PHY, CONFIG_MMC_*, CONFIG_SWCONFIG, ...) are NOT part of it:
# "make defconfig" drops them silently, so listing them here only created the
# illusion that they were set. The DSA core is enabled where the kernel config
# is actually generated - scripts/prepare.sh edits
# target/linux/generic/config-6.18.
CONFIG_TARGET_rockchip=y
CONFIG_TARGET_rockchip_armv8=y
CONFIG_TARGET_rockchip_armv8_DEVICE_jiyun_a10=y
CONFIG_TARGET_KERNEL_PARTSIZE=64
CONFIG_TARGET_ROOTFS_PARTSIZE=256
CONFIG_TARGET_ROOTFS_EXT4FS=y
# CONFIG_TARGET_ROOTFS_SQUASHFS is not set
CONFIG_TARGET_EXT4_BLOCKSIZE_4K=y
# module BTF rejected cfg80211/mac80211 signatures on this setup
# CONFIG_KERNEL_DEBUG_INFO_BTF is not set

# QModem: use the in-tree generic QMI WWAN driver instead of the feed's
# out-of-tree vendor driver. The vendor driver tracks older kernels and is the
# main build risk for this board; the generic one is enough for the modem
# management/UI work here.
CONFIG_PACKAGE_qmodem_INCLUDE_generic-qmi-wwan=y
# CONFIG_PACKAGE_qmodem_INCLUDE_vendor-qmi-wwan is not set
# QModem's bundled ndisc6 1.0.2 fails to build on this toolchain and is not
# needed for the WiFi/modem bring-up; disable it.
# CONFIG_PACKAGE_qmodem_INCLUDE_ndisc6 is not set

# Multi-SSID routing: build both cores so VMess/Trojan/SS and
# Hysteria2/TUIC nodes from the same subscription all work.
# OpenClash stays installed but must not run at the same time as PassWall2.
CONFIG_PACKAGE_luci-app-passwall2=y
CONFIG_PACKAGE_luci-app-passwall2_Nftables_Transparent_Proxy=y
# PassWall2's nftables backend needs dnsmasq-full (nftset support).
CONFIG_PACKAGE_dnsmasq-full=y
# CONFIG_PACKAGE_dnsmasq is not set
# CONFIG_PACKAGE_luci-app-passwall2_Iptables_Transparent_Proxy is not set
CONFIG_PACKAGE_luci-app-passwall2_Basic_Core_All=y
# CONFIG_PACKAGE_luci-app-passwall2_Basic_Core_Xray is not set
# CONFIG_PACKAGE_luci-app-passwall2_Basic_Core_SingBox is not set

# eMMC health UI (adminchenyu/eMMC-Health v1.1.3) + the extcsd reader it uses.
# The upstream Makefile depends on luci-js-deps (an iStoreOS-only meta that is
# not in Lean's luci feed); the vendored Makefile drops it and depends on
# mmc-utils directly.
CONFIG_PACKAGE_luci-app-emmc-health=y
CONFIG_PACKAGE_mmc-utils=y

# PassWall2's Makefile hard-depends on v2ray-geoip/v2ray-geosite. Lean's
# packages feed has xray/sing-box/tcping/geoview/chinadns-ng but not the
# v2ray geodata packages; they come from the separate passwall-packages feed
# (only v2ray-geodata is installed there, to avoid duplicate cores).
CONFIG_PACKAGE_v2ray-geoip=y
CONFIG_PACKAGE_v2ray-geosite=y

# MTK vendor wifi driver (package/mtk/drivers/mt_wifi_a10)
CONFIG_MTK_SUPPORT_OPENWRT=y
CONFIG_MTK_WIFI_DRIVER=y
# Select the packages explicitly as well: a stale package scan used to drop
# kmod-mt_wifi from .config even though DEVICE_PACKAGES listed it.
CONFIG_PACKAGE_kmod-mt_wifi=y
CONFIG_PACKAGE_wifi-profile=y
CONFIG_PACKAGE_wifi-dats=y
CONFIG_PACKAGE_datconf=y
CONFIG_PACKAGE_datconf-lua=y
CONFIG_PACKAGE_luci-app-mtk=y
CONFIG_PACKAGE_luci-compat=y
CONFIG_PACKAGE_luci-lua-runtime=y
CONFIG_PACKAGE_hostapd-common=y
# The vendor wifi-profile package installs its own /sbin/wifi; the standard
# wifi-scripts package would fight over the same path.
# CONFIG_PACKAGE_wifi-scripts is not set
CONFIG_MTK_FIRST_IF_MT7916=y
CONFIG_MTK_SECOND_IF_NONE=y
CONFIG_MTK_THIRD_IF_NONE=y
CONFIG_MTK_RT_FIRST_IF_RF_OFFSET=0x0
CONFIG_MTK_MT_WIFI=m
CONFIG_MTK_MT_WIFI_PATH="mt_wifi"
CONFIG_MTK_FIRST_IF_EEPROM_FLASH=y
CONFIG_MTK_RT_FIRST_CARD_EEPROM="flash"
CONFIG_MTK_WIFI_BASIC_FUNC=y
CONFIG_MTK_DOT11_N_SUPPORT=y
CONFIG_MTK_DOT11_VHT_AC=y
CONFIG_MTK_DOT11_HE_AX=y
CONFIG_MTK_CFG_SUPPORT_FALCON_MURU=y
CONFIG_MTK_CFG_SUPPORT_FALCON_TXCMD_DBG=y
CONFIG_MTK_CFG_SUPPORT_FALCON_SR=y
CONFIG_MTK_CFG_SUPPORT_FALCON_PP=y
CONFIG_MTK_WIFI_TWT_SUPPORT=y
CONFIG_MTK_G_BAND_256QAM_SUPPORT=y
CONFIG_MTK_TPC_SUPPORT=y
CONFIG_MTK_ICAP_SUPPORT=y
CONFIG_MTK_SPECTRUM_SUPPORT=y
CONFIG_MTK_PHY_ICS_SUPPORT=y
CONFIG_MTK_BACKGROUND_SCAN_SUPPORT=y
CONFIG_MTK_SMART_CARRIER_SENSE_SUPPORT=y
CONFIG_MTK_MT_DFS_SUPPORT=y
CONFIG_MTK_OFFCHANNEL_SCAN_FEATURE=y
CONFIG_MTK_HDR_TRANS_TX_SUPPORT=y
CONFIG_MTK_HDR_TRANS_RX_SUPPORT=y
CONFIG_MTK_DBDC_MODE=y
CONFIG_MTK_WSC_INCLUDED=y
CONFIG_MTK_WSC_V2_SUPPORT=y
CONFIG_MTK_DOT11W_PMF_SUPPORT=y
CONFIG_MTK_TXBF_SUPPORT=y
CONFIG_MTK_IGMP_SNOOP_SUPPORT=y
CONFIG_MTK_RTMP_FLASH_SUPPORT=y
# These default to y in config.in, but the pre-calibration image macros
# (PRE_CAL_SIZE_ONE_CARD, DCOC_IMAGE_SIZE, DPDPART*) are not present in the
# vendored source.  The G68 reference disables all three as well.
# CONFIG_MTK_PRE_CAL_TRX_SET1_SUPPORT is not set
# CONFIG_MTK_RLM_CAL_CACHE_SUPPORT is not set
# CONFIG_MTK_PRE_CAL_TRX_SET2_SUPPORT is not set
CONFIG_MTK_CAL_BIN_FILE_SUPPORT=y
CONFIG_MTK_ATE_SUPPORT=y
CONFIG_MTK_WLAN_SERVICE=y
CONFIG_MTK_MBO_SUPPORT=y
CONFIG_MTK_MAP_SUPPORT=y
CONFIG_MTK_UAPSD=y
CONFIG_MTK_RED_SUPPORT=y
CONFIG_MTK_FIRST_IF_IPAILNA=y
CONFIG_MTK_WIFI_FW_BIN_LOAD=y
CONFIG_MTK_WIFI_MODE_AP=m
CONFIG_MTK_MT_AP_SUPPORT=m
# CONFIG_MTK_CFG80211_SUPPORT is not set
CONFIG_MTK_WDS_SUPPORT=y
CONFIG_MTK_MBSS_SUPPORT=y
CONFIG_MTK_APCLI_SUPPORT=y
CONFIG_MTK_MUMIMO_SUPPORT=y
CONFIG_MTK_MU_RA_SUPPORT=y
CONFIG_MTK_DOT11R_FT_SUPPORT=y
CONFIG_MTK_DOT11K_RRM_SUPPORT=y
CONFIG_MTK_MLME_MULTI_QUEUE_SUPPORT=y
CONFIG_MTK_WIFI_EAP_FEATURE=y
CONFIG_MTK_VLAN_SUPPORT=y
CONFIG_MTK_ANTENNA_CONTROL_SUPPORT=y
CONFIG_MTK_MGMT_TXPWR_CTRL=y
CONFIG_MTK_RA_PHY_RATE_SUPPORT=y
CONFIG_MTK_AMPDU_CONF_SUPPORT=y
CONFIG_MTK_ACK_CTS_TIMEOUT_SUPPORT=y
CONFIG_MTK_MBSS_DTIM_SUPPORT=y
CONFIG_MTK_QOS_R1_SUPPORT=y
CONFIG_MTK_CON_WPS_SUPPORT=y
CONFIG_MTK_MCAST_RATE_SPECIFIC=y
CONFIG_MTK_VOW_SUPPORT=y
CONFIG_MTK_WLAN_HOOK=y
CONFIG_MTK_GREENAP_SUPPORT=y
CONFIG_MTK_AIR_MONITOR=y
CONFIG_MTK_WNM_SUPPORT=y
CONFIG_MTK_INTERWORKING=y
CONFIG_MTK_WPA3_SUPPORT=y
CONFIG_MTK_OWE_SUPPORT=y
CONFIG_MTK_WIFI_MT_MAC=y
CONFIG_MTK_MT_MAC=y
CONFIG_MTK_CHIP_MT7916=y

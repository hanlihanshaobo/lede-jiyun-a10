#!/bin/sh
# Jiyun A10 LED defaults (first boot only).
#
# The three front-panel LEDs are exposed as LED class devices so they can be
# managed from LuCI (System -> LED Configuration):
#
#   wlan  (left)  gpio4 C5,  netdev trigger on wlan0  -> blinks with 2.4G traffic
#   sys   (middle) gpio0 PC4, heartbeat while booting -> rc.local makes it solid
#   m2    (right) mt76-phy1,  netdev trigger on wlan1 -> blinks with 5G/M.2 traffic
#
# /etc/init.d/led applies this config early; rc.local re-applies it once the
# wireless interfaces exist and then turns the middle LED solid.

uci -q batch <<EOF
delete system.led_wlan
delete system.led_sys
delete system.led_m2

set system.led_wlan='led'
set system.led_wlan.name='wlan'
set system.led_wlan.sysfs='wlan'
set system.led_wlan.trigger='netdev'
set system.led_wlan.dev='wlan0'
set system.led_wlan.mode='tx rx'

set system.led_sys='led'
set system.led_sys.name='sys'
set system.led_sys.sysfs='sys'
set system.led_sys.trigger='heartbeat'

set system.led_m2='led'
set system.led_m2.name='m2'
set system.led_m2.sysfs='mt76-phy1'
set system.led_m2.trigger='netdev'
set system.led_m2.dev='wlan1'
set system.led_m2.mode='tx rx'

commit system
EOF

exit 0

#!/bin/sh
# Jiyun A10 network defaults.
#
# The RTL8367S is driven by the mainline DSA driver (kmod-dsa-rtl8365mb), so
# every switch port is a real netdev:
#   lan1, lan2, lan3  - the three LAN jacks (switch ports 0/1/3)
#   wan               - the WAN jack        (switch port 4)
#   (port 2 is not populated on this board)
#
# All we have to do here is build the LAN bridge out of the three LAN ports
# and point the WAN interface at the "wan" netdev.

uci -q batch <<EOF
delete network.@switch[0]
delete network.@switch_vlan[0]
delete network.@switch_vlan[1]

set network.lan.device='br-lan'

delete network.brlan
set network.brlan='device'
set network.brlan.name='br-lan'
set network.brlan.type='bridge'
delete network.brlan.ports
add_list network.brlan.ports='lan1'
add_list network.brlan.ports='lan2'
add_list network.brlan.ports='lan3'

# NOTE: named section - "add network interface" would create an anonymous one
delete network.wan
set network.wan='interface'
set network.wan.device='wan'
set network.wan.proto='dhcp'

commit network
EOF

exit 0

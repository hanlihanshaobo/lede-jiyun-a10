diff --git a/debugfs.c b/debugfs.c
--- a/debugfs.c
+++ b/debugfs.c
@@ -4,6 +4,38 @@
  */
 #include "mt76.h"
 
+static u32 mt76_vendor_cmd;
+static u32 mt76_vendor_arg0;
+static u32 mt76_vendor_arg1;
+
+static int
+mt76_vendor_send_get(void *data, u64 *val)
+{
+	*val = 0;
+	return 0;
+}
+
+static int
+mt76_vendor_send_set(void *data, u64 val)
+{
+	struct mt76_dev *dev = data;
+	u32 payload[2] = { mt76_vendor_arg0, mt76_vendor_arg1 };
+
+	if (!val)
+		return 0;
+
+	/* Experimental hook for the vendor LED command.  The vendor
+	 * mt_wifi driver sends an Andes command with tag 0x17ed and an
+	 * 8-byte {LEDStatus, BandIdx} payload; try the same CID through
+	 * the mainline MCU path.
+	 */
+	return mt76_mcu_send_msg(dev, mt76_vendor_cmd, payload,
+				 sizeof(payload), false);
+}
+
+DEFINE_DEBUGFS_ATTRIBUTE(fops_vendor_send, mt76_vendor_send_get,
+			 mt76_vendor_send_set, "%llu\n");
+
 static int
 mt76_reg_set(void *data, u64 val)
 {
@@ -120,6 +152,11 @@
 		debugfs_create_blob("otp", 0400, dir, &dev->otp);
 	debugfs_create_devm_seqfile(dev->dev, "rx-queues", dir,
 				    mt76_rx_queues_read);
+	debugfs_create_u32("vendor_cmd", 0600, dir, &mt76_vendor_cmd);
+	debugfs_create_u32("vendor_arg0", 0600, dir, &mt76_vendor_arg0);
+	debugfs_create_u32("vendor_arg1", 0600, dir, &mt76_vendor_arg1);
+	debugfs_create_file_unsafe("vendor_send", 0600, dir, dev,
+				   &fops_vendor_send);
 
 	return dir;
 }

#!/bin/sh
# Stable, per-device MAC addresses derived from the eMMC CID.
#
# The board has no factory MAC storage that OpenWrt can read (the real ones
# live in the WayOS Config_new partition of the SPI NOR, which mainline cannot
# access), so derive a locally-administered MAC from the eMMC CID instead:
#   * different for every board  (CID is unique)
#   * identical after every reboot and after re-flashing the rootfs
#     (the seed is in the eMMC hardware, not in /etc/config)
#
# Offsets follow the stock scheme:
#   LAN  = base
#   WAN  = base + 8
#   2.4G = base - 5
#   5G   = base + 3
#
# If you want the real factory MACs back use ./identity_restore.sh - it
# overwrites what this script sets.

. /lib/functions/system.sh

[ -n "$(uci -q get network.dev_eth0.macaddr)" ] && exit 0

BASE="$(macaddr_generate_from_mmc_cid mmcblk0 2>/dev/null)"
[ -n "$BASE" ] || exit 0

LAN_MAC="$BASE"
WAN_MAC="$(macaddr_add "$BASE" 8)"
WL24_MAC="$(macaddr_add "$BASE" -5)"
WL5_MAC="$(macaddr_add "$BASE" 3)"

logger -t jiyun-mac "eMMC CID MAC base: $BASE"

uci -q batch <<EOF
delete network.dev_eth0
set network.dev_eth0='device'
set network.dev_eth0.name='eth0'
set network.dev_eth0.macaddr='$LAN_MAC'

# visible LAN side (bridge / DSA ports)
set network.lan.macaddr='$LAN_MAC' 2>/dev/null || true
set network.dev_lan='device'
set network.dev_lan.name='br-lan'
set network.dev_lan.macaddr='$LAN_MAC'

set network.wan.macaddr='$WAN_MAC' 2>/dev/null || true

set wireless.default_radio0.macaddr='$WL24_MAC' 2>/dev/null || true
set wireless.default_radio1.macaddr='$WL5_MAC' 2>/dev/null || true

commit network
commit wireless
EOF

exit 0

#!/bin/sh
# Configure the RTL8367S switch on the Jiyun A10.
#
# The rtl8367b swconfig driver leaves the CPU port out of the VLANs unless it
# is told otherwise, so without this the LAN would stay dead.
#
# The board has only FOUR RJ45 ports (WAN + 3x LAN); RTL8367S port 2 is not
# populated and must stay out of the VLANs.  Same mapping the stock firmware
# uses (rtl8367_init.sh "L123" variant: 4081 => ports 0,1,3 + CPU, 4082 => 4):
#   0,1,3  LAN
#   4      WAN
#   7      CPU (RGMII to gmac0)
#
# eth0 is the CPU port (untagged VLAN 1 = LAN); the WAN is VLAN 2, tagged on
# the CPU port, hence it shows up as eth0.2.

DEV="$(swconfig list 2>/dev/null | sed -n 's/^\(switch[0-9][0-9]*\):.*/\1/p' | head -1)"
[ -n "$DEV" ] || DEV=switch0

uci -q batch <<EOF
delete network.@switch[0]
delete network.@switch_vlan[0]
delete network.@switch_vlan[1]

add network switch
set network.@switch[-1].name='$DEV'
set network.@switch[-1].reset='1'
set network.@switch[-1].enable_vlan='1'

add network switch_vlan
set network.@switch_vlan[-1].device='$DEV'
set network.@switch_vlan[-1].vlan='1'
set network.@switch_vlan[-1].ports='0 1 3 7'

add network switch_vlan
set network.@switch_vlan[-1].device='$DEV'
set network.@switch_vlan[-1].vlan='2'
set network.@switch_vlan[-1].ports='4 7t'

delete network.wan
add network interface
set network.@interface[-1].name='wan'
set network.@interface[-1].device='eth0.2'
set network.@interface[-1].proto='dhcp'

commit network
EOF

# apply right away (harmless if the network is not up yet)
swconfig dev "$DEV" vlan 1 set ports '0 1 3 7' 2>/dev/null
swconfig dev "$DEV" vlan 2 set ports '4 7t' 2>/dev/null
swconfig dev "$DEV" set apply 2>/dev/null

exit 0
